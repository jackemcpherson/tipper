{
  "name": "@jackemcpherson/tipper",
  "version": "4.0.0",
  "private": true,
  "description": "Production AFL match predictions and publication evidence on Cloudflare Workers",
  "homepage": "https://github.com/jackemcpherson/tipper#readme",
  "bugs": "https://github.com/jackemcpherson/tipper/issues",
  "license": "MIT",
  "author": "Jack McPherson <jackemcpherson@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackemcpherson/tipper.git"
  },
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "check": "vp check",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vp test",
    "build": "bun tools/build.ts",
    "types": "wrangler types src/env.d.ts --env-interface Env --include-runtime false"
  },
  "dependencies": {
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261103.1",
    "@effect/vitest": "4.1.2",

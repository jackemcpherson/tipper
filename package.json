    "@types/bun": "1.4.4",
    "miniflare": "5.20260730.0-alpha",
    "typescript": "7.0.2",
    "vite-plus": "1.5.1",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.1",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
